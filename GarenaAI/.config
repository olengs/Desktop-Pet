# Non-secret Garena AI runtime settings.
# Keep API keys in .env.

OPENAI_RESPONSE_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_MAX_OUTPUT_TOKENS=240
OPENAI_REASONING_EFFORT=medium

GARENA_PET_SAVE_WAV=1
GARENA_PET_SAVE_TTS_WAV=1
GARENA_PET_GRPC_TTS=0
GARENA_PET_GRPC_HEARTBEAT_SECONDS=30
GARENA_PET_WAV_DIR=

# Non-secret PostgreSQL settings. Keep the password in .env.
GARENA_DB_HOST=pg-1a218b76-smu-fe3e.c.aivencloud.com
GARENA_DB_PORT=11738
GARENA_DB_NAME=jctestdb
GARENA_DB_USER=avnadmin
GARENA_DB_SSLMODE=require
GARENA_DB_CONNECT_TIMEOUT=10

# Memory recall and storage controls.
GARENA_MEMORY_ENABLED=1
GARENA_MEMORY_SAVE_CHAT_HISTORY=1
GARENA_MEMORY_MAX_CHAT_MESSAGES=8
GARENA_MEMORY_MAX_CONTEXT_CHARS=6000

FISH_TTS_BACKEND=s2-pro
FISH_TTS_FORMAT=wav
FISH_TTS_SAMPLE_RATE=44100
FISH_TTS_MP3_BITRATE=128
FISH_TTS_LATENCY=balanced
FISH_TTS_CHUNK_LENGTH=200
FISH_TTS_NORMALIZE=1
